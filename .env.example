# Copy to .env and fill in. Never commit .env.

# ---- LLM provider: groq | openai | ollama ----
LLM_PROVIDER=groq
LLM_MODEL=                      # blank = provider default (groq: llama-3.3-70b-versatile)
LLM_TEMPERATURE=0.1
GROQ_API_KEY=                   # free key: https://console.groq.com/keys
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Embeddings (Sentence Transformers) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu            # cpu | cuda | mps

# ---- Chunking ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Retrieval ----
TOP_K=5
SEARCH_TYPE=mmr                 # mmr (diverse) | similarity
FETCH_K=20
SCORE_THRESHOLD=0.0             # only used with SEARCH_TYPE=similarity

# ---- Memory / storage ----
MEMORY_WINDOW=6
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=general        # default workspace
MAX_FILE_MB=50
LOG_LEVEL=INFO
